<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <!-- TOP OVERLAY (TV / LANDSCAPE: 1 WIDE ROW) -->
    <LinearLayout
        android:id="@+id/topOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#B3000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/yt_white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlayerChannel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/yt_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSpeedSelector"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#272727"
            android:focusable="true"
            android:text="⏱️ 1.0x"
            android:textAllCaps="false"
            android:textColor="@color/yt_white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnQualitySelector"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#272727"
            android:focusable="true"
            android:text="⚙️ 1080p HD"
            android:textAllCaps="false"
            android:textColor="@color/yt_white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnToggleRelated"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#272727"
            android:focusable="true"
            android:text="📺 Más Videos"
            android:textAllCaps="false"
            android:textColor="@color/yt_white"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnNextSafeVideo"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#272727"
            android:focusable="true"
            android:text="⏭ Siguiente"
            android:textAllCaps="false"
            android:textColor="@color/yt_white"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPlayerParentalPin"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#333333"
            android:focusable="true"
            android:text="🔒 Canal"
            android:textAllCaps="false"
            android:textColor="@color/yt_white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- BOTTOM OVERLAY: SAFE RELATED VIDEOS ROW -->
    <LinearLayout
        android:id="@+id/relatedStripContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E6101010"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📺 Videos Relacionados (100% Filtrados Anti-Brainrot)"
                android:textColor="@color/yt_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCloseRelated"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:backgroundTint="#2B2B2B"
                android:focusable="true"
                android:text="✕ Ocultar"
                android:textAllCaps="false"
                android:textColor="@color/yt_white"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRelatedVideos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/playerLoading"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/yt_red" />

</FrameLayout>
