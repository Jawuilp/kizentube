<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yt_bg"
    android:orientation="vertical">

    <!-- YOUTUBE MOBILE TOP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/yt_sidebar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_yt_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:letterSpacing="-0.03"
            android:text="YouTube"
            android:textColor="@color/yt_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_duration_badge"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="🛡️ Escudo"
            android:textColor="#4ADE80"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navSearch"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_nav_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="🔍"
            android:textColor="@color/yt_white"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- SECTION SUBHEADER & OPTIONAL SEARCH/PROFILE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/tvSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingBottom="6dp"
            android:text="Recomendados"
            android:textColor="@color/yt_white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/searchBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/etSearchQuery"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_selector"
                android:hint="Buscar videos filtrados..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/yt_white"
                android:textColorHint="@color/yt_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnRunSearch"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/yt_red"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Buscar"
                android:textAllCaps="false"
                android:textColor="@color/yt_white"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profileHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_row_selector"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvProfileAccountSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👤 Cuenta: Conectada"
                    android:textColor="@color/yt_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnProfileSync"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#272727"
                        android:text="🔄 Sincronizar"
                        android:textAllCaps="false"
                        android:textColor="@color/yt_white"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnProfileClearHistory"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:backgroundTint="#3A1D1D"
                        android:text="🗑️ Limpiar Historial"
                        android:textAllCaps="false"
                        android:textColor="@color/yt_white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:text="Canales Seguidos:"
                android:textColor="@color/yt_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/followedChannelsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvProfileHistoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Historial de Reproducción"
                android:textColor="@color/yt_white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVideos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <LinearLayout
                android:id="@+id/loadingContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:indeterminateTint="@color/yt_red" />

                <TextView
                    android:id="@+id/tvLoadingMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Analizando y limpiando el feed antes de mostrar..."
                    android:textColor="@color/yt_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- YOUTUBE MOBILE BOTTOM NAVIGATION BAR (ZERO SHORTS TAB) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#262626" />

    <LinearLayout
        android:id="@+id/sidebarContainer"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/yt_sidebar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🏠\nInicio"
            android:textColor="@color/yt_white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navSubscriptions"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="📺\nSuscrip."
            android:textColor="@color/yt_white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="👤\nPerfil"
            android:textColor="@color/yt_white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navParentalPin"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🔒\nAjustes"
            android:textColor="@color/yt_muted"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
